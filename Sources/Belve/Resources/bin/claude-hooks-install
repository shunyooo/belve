#!/usr/bin/env python3
# claude-hooks-install: inject Belve hooks into ~/.claude/settings.json
#
# 目的: agent-watch (@belve_state / OSC) を「Belve が起動した claude」だけでなく
# **全ての claude セッション** で効かせる。以前は belve claude wrapper が
# `--settings` で BELVE_SESSION 時のみ注入していたため、生 SSH / モバイル attach /
# 手動 `claude --resume` 等 Belve 外で起動した claude はフックを読まず状態を報告
# しなかった。グローバル settings.json に入れれば起動経路に依らず全 claude が
# 起動時にフックを読む。
#
# Idempotent + migration-safe: 自分のエントリだけを識別して入れ替える。
# 他ツール (moshi-hook / dock-code / claude-status-hook 等) のエントリや、
# settings.json の他のトップレベルキー (model, permissions 等) は絶対に touch しない。
#
# 識別マーカー: command 文字列が `<HOME>/.belve/bin/belve claude-hook` で
# 始まるもの = Belve 所有。それ以外は他ツール所有。
#
# Usage:
#   claude-hooks-install                # install / upgrade
#   claude-hooks-install --uninstall    # remove Belve entries only
import json
import os
import sys
import tempfile
from pathlib import Path

HOME = Path(os.path.expanduser("~"))
CONFIG_DIR = HOME / ".claude"
SETTINGS_FILE = CONFIG_DIR / "settings.json"
BELVE_CMD_PREFIX = str(HOME / ".belve" / "bin" / "belve") + " claude-hook"

# Belve が登録する hooks 一式。Claude Code wrapper (bin/claude の HOOKS_JSON) と
# 同じ event 群 + SessionEnd (NotificationStore の per-pane primary session cleanup 用)。
HOOKS_SPEC = [
    ("SessionStart",     "session-start",  5),
    ("SessionEnd",       "session-end",    1),
    ("UserPromptSubmit", "prompt-submit",  5),
    ("Notification",     "notification",   5),
    ("PreToolUse",       "pre-tool-use",   3),
    ("PostToolUse",      "post-tool-use",  3),
    ("SubagentStart",    "subagent-start", 3),
    ("SubagentStop",     "subagent-stop",  3),
    ("Stop",             "stop",           5),
]


def is_belve_owned(matcher: dict) -> bool:
    """matcher の hooks 配列内に Belve のマーカーで始まる command が 1 つでもあれば True。"""
    hooks = matcher.get("hooks") or []
    if not isinstance(hooks, list):
        return False
    for h in hooks:
        if not isinstance(h, dict):
            continue
        cmd = h.get("command")
        if isinstance(cmd, str) and cmd.startswith(BELVE_CMD_PREFIX):
            return True
    return False


def _backup_broken() -> None:
    """パース不能 / 想定外の型の settings.json を退避する (原本を失わないため)。"""
    backup = SETTINGS_FILE.with_suffix(".json.belve-broken")
    try:
        SETTINGS_FILE.replace(backup)
        print(f"[claude-hooks-install] WARN: existing settings.json unusable, backed up to {backup}", file=sys.stderr)
    except Exception:
        pass


def load_settings() -> dict:
    if not SETTINGS_FILE.exists():
        return {"hooks": {}}
    try:
        with open(SETTINGS_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception:
        # 既存ファイル壊れてる → backup して空でやり直し。
        _backup_broken()
        return {"hooks": {}}
    if not isinstance(data, dict):
        # 有効な JSON だが object でない (top-level array 等)。上書きで原本を失わない
        # よう、壊れ扱いで退避してからやり直す。
        _backup_broken()
        return {"hooks": {}}
    if "hooks" not in data or not isinstance(data["hooks"], dict):
        data["hooks"] = {}
    return data


def write_atomic(data: dict) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    fd, tmp_path = tempfile.mkstemp(dir=str(CONFIG_DIR), prefix=".settings.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
            f.write("\n")
        os.replace(tmp_path, SETTINGS_FILE)
    except Exception:
        try:
            os.unlink(tmp_path)
        except FileNotFoundError:
            pass
        raise


def remove_belve(data: dict) -> dict:
    hooks_root = data["hooks"]
    for event in list(hooks_root.keys()):
        matchers = hooks_root.get(event) or []
        if not isinstance(matchers, list):
            continue
        kept = [m for m in matchers if not (isinstance(m, dict) and is_belve_owned(m))]
        if kept:
            hooks_root[event] = kept
        else:
            # Empty event 配列は削除 (= 元から無かった事にする)
            del hooks_root[event]
    return data


def install(data: dict) -> dict:
    # まず既存 Belve エントリを除去 (= upgrade 時の旧版残存対策)
    remove_belve(data)
    # 新規追加。Claude Code の settings.json hook 形式は matcher フィールド必須。
    for event, subcmd, timeout in HOOKS_SPEC:
        new_matcher = {
            "matcher": "",
            "hooks": [
                {
                    "type": "command",
                    "command": f"{BELVE_CMD_PREFIX} {subcmd}",
                    "timeout": timeout,
                }
            ],
        }
        existing = data["hooks"].get(event) or []
        if not isinstance(existing, list):
            existing = []
        existing.append(new_matcher)
        data["hooks"][event] = existing
    return data


def main() -> int:
    uninstall = "--uninstall" in sys.argv[1:]
    data = load_settings()
    if uninstall:
        remove_belve(data)
    else:
        install(data)
    write_atomic(data)
    return 0


if __name__ == "__main__":
    sys.exit(main())
