#!/usr/bin/env bash
# Belve claude wrapper - thin passthrough to the real `claude`.
#
# 以前は BELVE_SESSION 時に --settings で belve hook を注入していたが、フックは
# グローバル ~/.claude/settings.json に移した (claude-hooks-install)。これで起動
# 経路に依らず全 claude がフックを読む。この wrapper の残った役目は 2 つだけ:
#  (1) Claude Code v2.1.x SessionStart mkdir bug の workaround (下記)。
#  (2) -p/--print 実行に BELVE_HOOK_RUNNING 印を付け、belve hook を抑制する。

set -euo pipefail

# Workaround for Claude Code v2.1.x SessionStart bug: it mkdirs
# ~/.claude/session-env/<id> with plain mkdir (not mkdir -p), so if the parent
# dir doesn't exist yet the hook errors out. Pre-create the parent unconditionally.
# Also handle the common devcontainer case where ~/.claude is a symlink to a
# path inside the workspace whose target doesn't exist yet (the symlink looks
# valid but mkdir -p refuses with "File exists" for a broken symlink).
if [ -L "$HOME/.claude" ] && [ ! -e "$HOME/.claude" ]; then
    _belve_link_target=$(readlink "$HOME/.claude" 2>/dev/null || true)
    if [ -n "$_belve_link_target" ]; then
        case "$_belve_link_target" in
            /*) ;;
            *)  _belve_link_target="$(dirname "$HOME/.claude")/$_belve_link_target" ;;
        esac
        mkdir -p "$_belve_link_target/session-env" 2>/dev/null || true
    fi
    unset _belve_link_target
fi
mkdir -p "$HOME/.claude/session-env" 2>/dev/null || true

find_real_claude() {
    local self_dir
    self_dir="$(cd "$(dirname "$0")" && pwd)"
    local IFS=:
    for d in $PATH; do
        [[ "$d" == "$self_dir" ]] && continue
        [[ -x "$d/claude" ]] && printf '%s' "$d/claude" && return 0
    done
    return 1
}

REAL_CLAUDE="$(find_real_claude)" || { echo "Error: claude not found in PATH" >&2; exit 127; }

# Belve の agent-watch フックは今やグローバル ~/.claude/settings.json に入っている
# (claude-hooks-install が merge)。よってこの wrapper は --settings 注入をしない。
# 唯一の残った役目は「belve event を出してはいけない invocation」に印を付けること:
#  - `-p` / `--print`: one-shot 実行。親セッションの状態バーを汚さない。
#  - hook が spawn した子 claude: 親 hook が既に BELVE_HOOK_RUNNING=1 を export して
#    いるので env 継承で自動的に印が付く (ここで何もしなくてよい)。
# 印が付いた invocation では belve hook (belve claude-hook) 側が early-exit する。
for _arg in "$@"; do
    case "$_arg" in
        -p|--print) export BELVE_HOOK_RUNNING=1; break ;;
    esac
done

exec "$REAL_CLAUDE" "$@"
